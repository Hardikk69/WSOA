{
  "info": {
    "name": "API Gateway – Lab 7",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Every request goes through the API Gateway ({{gateway}}). Local: http://localhost:8000. Cloud: set {{gateway}} to the public gateway URL and re-run folders 0–3. Folder 4 needs a service stopped first (see README)."
  },
  "variable": [
    {
      "key": "gateway",
      "value": "http://localhost:8000"
    },
    {
      "key": "userId",
      "value": "101"
    },
    {
      "key": "productId",
      "value": "501"
    },
    {
      "key": "orderId",
      "value": "901"
    }
  ],
  "item": [
    {
      "name": "0. Gateway",
      "item": [
        {
          "name": "Health Check",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Gateway is UP\", () => pm.expect(pm.response.json().status).to.eql(\"UP\"));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{gateway}}/health"
          }
        },
        {
          "name": "Unknown Route (404 from gateway)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 404\", () => pm.response.to.have.status(404));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{gateway}}/unknown"
          }
        }
      ]
    },
    {
      "name": "1. /users → User Service",
      "item": [
        {
          "name": "Create User",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 201\", () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set(\"userId\", pm.response.json().id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Aarav Shah\",\n  \"email\": \"aarav.{{$timestamp}}@campus.edu\",\n  \"course\": \"MSc IT\",\n  \"semester\": 3\n}"
            },
            "url": "{{gateway}}/users"
          }
        },
        {
          "name": "Get All Users",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{gateway}}/users"
          }
        },
        {
          "name": "Get User by ID",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{gateway}}/users/{{userId}}"
          }
        },
        {
          "name": "Update User",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Aarav Shah\",\n  \"email\": \"aarav.updated.{{$timestamp}}@campus.edu\",\n  \"course\": \"MSc IT\",\n  \"semester\": 4\n}"
            },
            "url": "{{gateway}}/users/{{userId}}"
          }
        },
        {
          "name": "Get Invalid User (404)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 404\", () => pm.response.to.have.status(404));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{gateway}}/users/99999"
          }
        }
      ]
    },
    {
      "name": "2. /products → Product Service",
      "item": [
        {
          "name": "Create Product",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 201\", () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set(\"productId\", pm.response.json().id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Campus Hoodie\",\n  \"category\": \"Merchandise\",\n  \"price\": 899,\n  \"stock\": 50\n}"
            },
            "url": "{{gateway}}/products"
          }
        },
        {
          "name": "Get All Products",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{gateway}}/products"
          }
        },
        {
          "name": "Get Product by ID",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{gateway}}/products/{{productId}}"
          }
        },
        {
          "name": "Update Product",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Campus Hoodie\",\n  \"category\": \"Merchandise\",\n  \"price\": 799,\n  \"stock\": 45\n}"
            },
            "url": "{{gateway}}/products/{{productId}}"
          }
        },
        {
          "name": "Get Invalid Product (404)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 404\", () => pm.response.to.have.status(404));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{gateway}}/products/99999"
          }
        }
      ]
    },
    {
      "name": "3. /orders → Order Service (Order → User / Product)",
      "item": [
        {
          "name": "Create Order (calls User + Product)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 201\", () => pm.response.to.have.status(201));",
                  "const o = pm.response.json();",
                  "pm.test(\"Order → User call returned user\", () => pm.expect(o.user.id).to.eql(o.userId));",
                  "pm.test(\"Order → Product call returned product\", () => pm.expect(o.product.id).to.eql(o.productId));",
                  "pm.collectionVariables.set(\"orderId\", o.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": {{userId}},\n  \"productId\": {{productId}},\n  \"quantity\": 2\n}"
            },
            "url": "{{gateway}}/orders"
          }
        },
        {
          "name": "Get All Orders",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{gateway}}/orders"
          }
        },
        {
          "name": "Get Order by ID",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{gateway}}/orders/{{orderId}}"
          }
        },
        {
          "name": "Create Order – Invalid User (404)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 404\", () => pm.response.to.have.status(404));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": 99999,\n  \"productId\": {{productId}},\n  \"quantity\": 1\n}"
            },
            "url": "{{gateway}}/orders"
          }
        },
        {
          "name": "Create Order – Invalid Product (404)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 404\", () => pm.response.to.have.status(404));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": {{userId}},\n  \"productId\": 99999,\n  \"quantity\": 1\n}"
            },
            "url": "{{gateway}}/orders"
          }
        }
      ]
    },
    {
      "name": "4. Unreachable Service (502/503)",
      "item": [
        {
          "name": "GET /products – Product Service DOWN (503)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 502 or 503\", () => pm.expect(pm.response.code).to.be.oneOf([502, 503]));",
                  "pm.test(\"Clear JSON error\", () => pm.expect(pm.response.json().error).to.be.a(\"string\"));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{gateway}}/products"
          }
        },
        {
          "name": "GET /products – After Restart (200)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{gateway}}/products"
          }
        }
      ]
    }
  ]
}