# ---- Service registry (read by api-gateway + order-service) ----
# Change a location here -> `docker compose up -d` -> no code change.
USER_SERVICE_PORT=3001
PRODUCT_SERVICE_PORT=3002
ORDER_SERVICE_PORT=3003
USER_SERVICE_URL=http://user-service:3001
PRODUCT_SERVICE_URL=http://product-service:3002
ORDER_SERVICE_URL=http://order-service:3003

# ---- Gateway ----
GATEWAY_PORT=8000
PROXY_TIMEOUT_MS=10000
REQUEST_TIMEOUT_MS=3000

# ---- Optional: point services at MongoDB Atlas instead of local mongo containers ----
# USER_MONGO_URI=mongodb+srv://<user>:<pass>@<cluster>/userdb?retryWrites=true&w=majority
# PRODUCT_MONGO_URI=mongodb+srv://<user>:<pass>@<cluster>/productdb?retryWrites=true&w=majority
# ORDER_MONGO_URI=mongodb+srv://<user>:<pass>@<cluster>/orderdb?retryWrites=true&w=majority
