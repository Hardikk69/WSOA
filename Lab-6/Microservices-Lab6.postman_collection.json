{
  "info": {
    "name": "Microservices – Lab 6",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "CampusConnect microservices: direct User/Product/Order tests, Order→User/Product communication, 404 and 503 handling. Run folders in order."
  },
  "variable": [
    {
      "key": "userBase",
      "value": "http://localhost:3001"
    },
    {
      "key": "productBase",
      "value": "http://localhost:3002"
    },
    {
      "key": "orderBase",
      "value": "http://localhost:3003"
    },
    {
      "key": "userId",
      "value": "101"
    },
    {
      "key": "productId",
      "value": "501"
    },
    {
      "key": "orderId",
      "value": "901"
    }
  ],
  "item": [
    {
      "name": "1. User Service",
      "item": [
        {
          "name": "Create User",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 201\", () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set(\"userId\", pm.response.json().id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Aarav Shah\",\n  \"email\": \"aarav.{{$timestamp}}@campus.edu\",\n  \"course\": \"MSc IT\",\n  \"semester\": 3\n}"
            },
            "url": {
              "raw": "{{userBase}}/users"
            }
          }
        },
        {
          "name": "Get All Users",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{userBase}}/users"
            }
          }
        },
        {
          "name": "Get User by ID",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{userBase}}/users/{{userId}}"
            }
          }
        },
        {
          "name": "Update User",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Aarav Shah\",\n  \"email\": \"aarav.updated.{{$timestamp}}@campus.edu\",\n  \"course\": \"MSc IT\",\n  \"semester\": 4\n}"
            },
            "url": {
              "raw": "{{userBase}}/users/{{userId}}"
            }
          }
        },
        {
          "name": "Get Invalid User (404)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 404\", () => pm.response.to.have.status(404));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{userBase}}/users/99999"
            }
          }
        }
      ]
    },
    {
      "name": "2. Product Service",
      "item": [
        {
          "name": "Create Product",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 201\", () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set(\"productId\", pm.response.json().id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Campus Hoodie\",\n  \"category\": \"Merchandise\",\n  \"price\": 899,\n  \"stock\": 50\n}"
            },
            "url": {
              "raw": "{{productBase}}/products"
            }
          }
        },
        {
          "name": "Get All Products",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{productBase}}/products"
            }
          }
        },
        {
          "name": "Get Product by ID",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{productBase}}/products/{{productId}}"
            }
          }
        },
        {
          "name": "Update Product",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Campus Hoodie\",\n  \"category\": \"Merchandise\",\n  \"price\": 799,\n  \"stock\": 45\n}"
            },
            "url": {
              "raw": "{{productBase}}/products/{{productId}}"
            }
          }
        },
        {
          "name": "Get Invalid Product (404)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 404\", () => pm.response.to.have.status(404));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{productBase}}/products/99999"
            }
          }
        }
      ]
    },
    {
      "name": "3. Order Service (Order → User / Product)",
      "item": [
        {
          "name": "Create Order (calls User + Product)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 201\", () => pm.response.to.have.status(201));",
                  "const o = pm.response.json();",
                  "pm.test(\"Order → User call returned user\", () => pm.expect(o.user.id).to.eql(o.userId));",
                  "pm.test(\"Order → Product call returned product\", () => pm.expect(o.product.id).to.eql(o.productId));",
                  "pm.collectionVariables.set(\"orderId\", o.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": {{userId}},\n  \"productId\": {{productId}},\n  \"quantity\": 2\n}"
            },
            "url": {
              "raw": "{{orderBase}}/orders"
            }
          }
        },
        {
          "name": "Get All Orders",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{orderBase}}/orders"
            }
          }
        },
        {
          "name": "Get Order by ID",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{orderBase}}/orders/{{orderId}}"
            }
          }
        },
        {
          "name": "Create Order – Invalid User (404)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 404\", () => pm.response.to.have.status(404));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": 99999,\n  \"productId\": {{productId}},\n  \"quantity\": 1\n}"
            },
            "url": {
              "raw": "{{orderBase}}/orders"
            }
          }
        },
        {
          "name": "Create Order – Invalid Product (404)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 404\", () => pm.response.to.have.status(404));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": {{userId}},\n  \"productId\": 99999,\n  \"quantity\": 1\n}"
            },
            "url": {
              "raw": "{{orderBase}}/orders"
            }
          }
        }
      ]
    },
    {
      "name": "4. Failure & Recovery",
      "description": "Before \"User Down\": run `docker compose stop user-service`. Before \"Recovery\": run `docker compose start user-service`.",
      "item": [
        {
          "name": "Create Order – User Service DOWN (503)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 503\", () => pm.response.to.have.status(503));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": {{userId}},\n  \"productId\": {{productId}},\n  \"quantity\": 1\n}"
            },
            "url": {
              "raw": "{{orderBase}}/orders"
            }
          }
        },
        {
          "name": "Create Order – After Restart (201)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 201\", () => pm.response.to.have.status(201));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": {{userId}},\n  \"productId\": {{productId}},\n  \"quantity\": 1\n}"
            },
            "url": {
              "raw": "{{orderBase}}/orders"
            }
          }
        }
      ]
    }
  ]
}